<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Cyber_Defense_Game.Views.PlayerUpgradeView">
        <Grid RowDefinitions="Auto,*,*,*" Margin="20">
        <TextBlock x:Name="StatusText"
                   Grid.Row="0"
                   Text="Vote for an upgrade or skip to save score!"
                   FontSize="26"
                   FontWeight="Bold"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,15" />

        <Button x:Name="Option1Button"
                Grid.Row="1"
                Background="#1E88E5"
                Foreground="White"
                FontSize="24"
                FontWeight="Bold"
                CornerRadius="16"
                Margin="10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Click="Option1_Click">
            <TextBlock x:Name="Option1Text"
                       Text="Upgrade 1"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
        </Button>

        <Button x:Name="Option2Button"
                Grid.Row="2"
                Background="#8E24AA"
                Foreground="White"
                FontSize="24"
                FontWeight="Bold"
                CornerRadius="16"
                Margin="10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Click="Option2_Click">
            <TextBlock x:Name="Option2Text"
                       Text="Upgrade 2"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
        </Button>

        <Button x:Name="SkipButton"
                Grid.Row="3"
                Background="#455A64"
                Foreground="White"
                FontSize="24"
                FontWeight="Bold"
                CornerRadius="16"
                Margin="10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Click="Skip_Click">
            <TextBlock Text="Skip (Save Score)"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
        </Button>
    </Grid>
</UserControl>