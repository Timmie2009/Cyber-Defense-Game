<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="Cyber_Defense_Game.Views.PlayerAnswerView">
 <DockPanel Margin="20">
        <TextBlock x:Name="StatusText"
                   DockPanel.Dock="Top"
                   Text="Pick an answer!"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,20" />

        <Grid>
            <!-- 4 answer buttons (shown while picking) -->
            <UniformGrid x:Name="AnswerGrid" Rows="2" Columns="2">
                <Button Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Margin="10"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Click="Red_Click">
                    <Image Source="avares://Cyber_Defense_Game/Assets/Rood.png"
                           Stretch="Uniform" />
                </Button>

                <Button Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Margin="10"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Click="Green_Click">
                    <Image Source="avares://Cyber_Defense_Game/Assets/Groen.png"
                           Stretch="Uniform" />
                </Button>

                <Button Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Margin="10"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Click="Blue_Click">
                    <Image Source="avares://Cyber_Defense_Game/Assets/Blauw.png"
                           Stretch="Uniform" />
                </Button>

                <Button Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Margin="10"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Click="White_Click">
                    <Image Source="avares://Cyber_Defense_Game/Assets/Wit.png"
                           Stretch="Uniform" />
                </Button>
            </UniformGrid>

            <!-- Full-screen image shown after picking an answer -->
            <Image x:Name="SelectedImage"
                   IsVisible="False"
                   Stretch="Uniform"
                   Margin="20" />
        </Grid>
    </DockPanel>
</UserControl>
