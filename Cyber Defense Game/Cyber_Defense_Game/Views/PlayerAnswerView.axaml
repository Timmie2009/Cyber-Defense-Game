<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="Cyber_Defense_Game.Views.PlayerAnswerView">
    <DockPanel Margin="20">
        <TextBlock x:Name="StatusText"
                   DockPanel.Dock="Top"
                   Text="Pick an answer!"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,20" />

        <UniformGrid Rows="2" Columns="2">
            <Button Content="Red"
                    Background="#E53935"
                    Foreground="White"
                    FontSize="32"
                    FontWeight="Bold"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Margin="10"
                    Click="Red_Click" />

            <Button Content="Green"
                    Background="#43A047"
                    Foreground="White"
                    FontSize="32"
                    FontWeight="Bold"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Margin="10"
                    Click="Green_Click" />

            <Button Content="Blue"
                    Background="#1E88E5"
                    Foreground="White"
                    FontSize="32"
                    FontWeight="Bold"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Margin="10"
                    Click="Blue_Click" />

            <Button Content="White"
                    Background="#F5F5F5"
                    Foreground="Black"
                    FontSize="32"
                    FontWeight="Bold"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Margin="10"
                    Click="White_Click" />
        </UniformGrid>
    </DockPanel>
</UserControl>
