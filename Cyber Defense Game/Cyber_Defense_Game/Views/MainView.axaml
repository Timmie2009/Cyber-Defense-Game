<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Cyber_Defense_Game.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Cyber_Defense_Game.Views.MainView"
             x:DataType="vm:MainViewModel">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>
        <Image Source="avares://Cyber_Defense_Game/Assets/lucid-origin_a_cinematic_photo_of_Playful_3D_cartoon_game_background_cute_glowing_cyber_shiel-0.png"
               Stretch="UniformToFill"
               IsHitTestVisible="False" />

        <ContentControl x:Name="ContentHost" />

        <TextBlock Text="v1.1.0"
                   Foreground="Red"
                   FontSize="24"
                   Opacity="0.6"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="20"
                   IsHitTestVisible="False" />
    </Grid>

</UserControl>
