<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Cyber_Defense_Game.Views.HostUpgradeView">
  <DockPanel Margin="30">
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,10,0,20">
            <TextBlock Text="Upgrade Shop"
                       FontSize="36"
                       FontWeight="Bold"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="ScoreStatusText"
                       Text="Available Score: 0"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#4CAF50"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="TimerText"
                       Text="Time left: 15"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#E53935"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="VoteCountText"
                       Text="Votes: 0 / 0"
                       FontSize="20"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Winner banner & Continue button -->
        <StackPanel x:Name="ResultPanel"
                    DockPanel.Dock="Bottom"
                    Spacing="15"
                    IsVisible="False"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0">
            <TextBlock x:Name="WinnerText"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#43A047"
                       HorizontalAlignment="Center" />
            <Button Content="Continue to Next Question"
                    FontSize="20"
                    HorizontalAlignment="Center"
                    Click="Continue_Click" />
        </StackPanel>

        <!-- Upgrade Cards + Skip Card -->
        <UniformGrid Rows="1" Columns="3" Margin="10">
            <Border x:Name="Card1Border" Background="#1E88E5" CornerRadius="16" Padding="20" Margin="10">
                <StackPanel VerticalAlignment="Center" Spacing="12">
                    <TextBlock x:Name="Upgrade1Title"
                               Text="Upgrade 1"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="White"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="Upgrade1Cost"
                               Text="Cost: 100 pts"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#FFD54F"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="Upgrade1Desc"
                               Text="Description 1"
                               FontSize="17"
                               Foreground="White"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <TextBlock x:Name="Upgrade1Votes"
                               Text="0 votes"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border x:Name="Card2Border" Background="#8E24AA" CornerRadius="16" Padding="20" Margin="10">
                <StackPanel VerticalAlignment="Center" Spacing="12">
                    <TextBlock x:Name="Upgrade2Title"
                               Text="Upgrade 2"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="White"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="Upgrade2Cost"
                               Text="Cost: 150 pts"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#FFD54F"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="Upgrade2Desc"
                               Text="Description 2"
                               FontSize="17"
                               Foreground="White"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <TextBlock x:Name="Upgrade2Votes"
                               Text="0 votes"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border Background="#455A64" CornerRadius="16" Padding="20" Margin="10">
                <StackPanel VerticalAlignment="Center" Spacing="12">
                    <TextBlock Text="Skip &amp; Save Score"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="White"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Cost: 0 pts"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#81C784"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Koop geen upgrade en bewaar alle punten voor een duurdere power-up later."
                               FontSize="17"
                               Foreground="White"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <TextBlock x:Name="SkipVotesText"
                               Text="0 votes"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </UniformGrid>
    </DockPanel>
</UserControl>