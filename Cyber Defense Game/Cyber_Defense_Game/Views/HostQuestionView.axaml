<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="Cyber_Defense_Game.Views.HostQuestionView">
     <DockPanel Margin="30">
        <!-- Question & Countdown Header -->
        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,10,0,20" HorizontalAlignment="Center">
            <TextBlock x:Name="QuestionTitleText"
                       Text="What color is the sky?"
                       FontSize="36"
                       FontWeight="Bold"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="TimerText"
                       Text="Time left: 10"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="#E53935"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Hidden until timer reaches 0 -->
        <StackPanel x:Name="ResultsPanel"
                    DockPanel.Dock="Bottom"
                    Spacing="10"
                    IsVisible="False">
            <Grid>
                <TextBlock Text="Results:"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
                <Button Content="Next Question"
                        HorizontalAlignment="Right"
                        Click="NextQuestion_Click" />
            </Grid>
            <ListBox x:Name="AnswersList" Height="180" />
        </StackPanel>

        <!-- 4 answer previews on the host screen -->
        <UniformGrid Rows="2" Columns="2" Margin="20">
            <Border Background="#E53935" CornerRadius="12" Margin="10">
                <TextBlock x:Name="OptionAText"
                           Text="A: Red"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <Border Background="#43A047" CornerRadius="12" Margin="10">
                <TextBlock x:Name="OptionBText"
                           Text="B: Green"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <Border Background="#1E88E5" CornerRadius="12" Margin="10">
                <TextBlock x:Name="OptionCText"
                           Text="C: Blue"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <Border Background="#F5F5F5" CornerRadius="12" Margin="10">
                <TextBlock x:Name="OptionDText"
                           Text="D: White"
                           Foreground="Black"
                           FontSize="28"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
        </UniformGrid>
    </DockPanel>
</UserControl>