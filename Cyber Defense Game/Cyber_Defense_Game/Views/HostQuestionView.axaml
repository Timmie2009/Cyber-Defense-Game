<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="Cyber_Defense_Game.Views.HostQuestionView">
    <DockPanel Margin="30">
        <TextBlock DockPanel.Dock="Top"
                   Text="What color is the sky?"
                   FontSize="36"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,30" />

        <StackPanel DockPanel.Dock="Bottom" Spacing="10">
            <TextBlock Text="Answers received:" FontSize="18" FontWeight="Bold" />
            <ListBox x:Name="AnswersList" Height="150" />
        </StackPanel>

        <!-- 4 answer previews on the host screen -->
        <UniformGrid Rows="2" Columns="2" Margin="20">
            <Border Background="#E53935" CornerRadius="12" Margin="10">
                <TextBlock Text="Red" Foreground="White" FontSize="28" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border Background="#43A047" CornerRadius="12" Margin="10">
                <TextBlock Text="Green" Foreground="White" FontSize="28" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border Background="#1E88E5" CornerRadius="12" Margin="10">
                <TextBlock Text="Blue" Foreground="White" FontSize="28" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border Background="#F5F5F5" CornerRadius="12" Margin="10">
                <TextBlock Text="White" Foreground="Black" FontSize="28" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </UniformGrid>
    </DockPanel>
</UserControl>
