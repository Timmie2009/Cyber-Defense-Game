<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="Cyber_Defense_Game.Views.HostQuestionView">
        <DockPanel Margin="30">
        <!-- Top Header with Score, Lives & Active Buff on Top-Left -->
 <Grid DockPanel.Dock="Top" Margin="0,0,0,15">
    <Border Background="#1B263B"
            BorderBrush="#415A77"
            BorderThickness="2"
            CornerRadius="12"
            Padding="14,8"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">
        <StackPanel Spacing="4">
            <TextBlock x:Name="ScoreText"
                       Text="Score: 0"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#4CAF50" />
            <TextBlock x:Name="LivesText"
                       Text="Lives: ❤️❤️❤️ (3/3)"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#FF5252" />
            <TextBlock x:Name="ActiveBuffText"
                       Text=""
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#FFD54F"
                       IsVisible="False" />
        </StackPanel>
    </Border>

    <StackPanel Spacing="8"
                Margin="220,0,220,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
        <TextBlock x:Name="QuestionTitleText"
                   Text="What color is the sky?"
                   FontSize="32"
                   FontWeight="Bold"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   HorizontalAlignment="Center" />
        <TextBlock x:Name="TimerText"
                   Text="Time left: 30"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="#E53935"
                   HorizontalAlignment="Center" />
        <TextBlock x:Name="AnsweredCountText"
                   Text="Answered: 0 / 0"
                   FontSize="20"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center" />
    </StackPanel>
</Grid>

        <!-- Hidden until timer reaches 0 -->
        <StackPanel x:Name="ResultsPanel"
                    DockPanel.Dock="Bottom"
                    Spacing="10"
                    IsVisible="False">
            <Grid>
                <TextBlock Text="Results:"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
                <Button Content="Next Question"
                        HorizontalAlignment="Right"
                        Click="NextQuestion_Click" />
            </Grid>
            <ListBox x:Name="AnswersList" Height="180" />
        </StackPanel>

        <!-- 4 answer previews on the host screen -->
        <UniformGrid Rows="2" Columns="2" Margin="20">
            <Border x:Name="OptionABorder" Background="#E53935" CornerRadius="12" Margin="10">
                <TextBlock x:Name="OptionAText"
                           Text="A: Red"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <Border x:Name="OptionBBorder" Background="#43A047" CornerRadius="12" Margin="10">
                <TextBlock x:Name="OptionBText"
                           Text="B: Green"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <Border x:Name="OptionCBorder" Background="#1E88E5" CornerRadius="12" Margin="10">
                <TextBlock x:Name="OptionCText"
                           Text="C: Blue"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <Border x:Name="OptionDBorder" Background="#F5F5F5" CornerRadius="12" Margin="10">
                <TextBlock x:Name="OptionDText"
                           Text="D: White"
                           Foreground="Black"
                           FontSize="28"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
        </UniformGrid>
    </DockPanel>
</UserControl>