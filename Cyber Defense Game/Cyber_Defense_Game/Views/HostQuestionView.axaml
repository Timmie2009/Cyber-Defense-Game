<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="Cyber_Defense_Game.Views.HostQuestionView">
  <DockPanel Margin="30">
        <!-- Top Header: Score pinned Top-Left, Question Centered across full width -->
      <Grid DockPanel.Dock="Top" Margin="0,0,0,15">
    <Grid HorizontalAlignment="Left"
          VerticalAlignment="Top"
          MaxWidth="280">
        <Image Source="avares://Cyber_Defense_Game/Assets/cyberpunk-knop-zwart-hd.png"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center" />

        <StackPanel Spacing="2"
                    Margin="28,12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock x:Name="ScoreText"
                       Text="Score: 0"
                       FontSize="19"
                       FontWeight="Bold"
                       Foreground="#4CAF50"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="LivesText"
                       Text="Lives: ❤️❤️❤️ (3/3)"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#FF5252"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="ActiveBuffText"
                       Text=""
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="#FFD54F"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       IsVisible="False" />
        </StackPanel>
    </Grid>
<Border Background="#B30D1B2A"
        BorderBrush="#415A77"
        BorderThickness="2"
        CornerRadius="16"
        Padding="24,14"
        Margin="290,0,290,0"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">
    <StackPanel Spacing="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
        <TextBlock x:Name="QuestionTitleText"
                   Text="What color is the sky?"
                   Foreground="White"
                   FontSize="32"
                   FontWeight="Bold"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   HorizontalAlignment="Center" />
        <TextBlock x:Name="TimerText"
                   Text="Time left: 30"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="#FF5252"
                   HorizontalAlignment="Center" />
        <TextBlock x:Name="AnsweredCountText"
                   Text="Answered: 0 / 0"
                   Foreground="#E0E1DD"
                   FontSize="20"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center" />
    </StackPanel>
</Border>
</Grid>

        <!-- Hidden until timer reaches 0 -->
        <StackPanel x:Name="ResultsPanel"
                    DockPanel.Dock="Bottom"
                    Spacing="10"
                    IsVisible="False">
            <Grid>
                <TextBlock Text="Results:"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
                <Button Content="Next Question"
                        HorizontalAlignment="Right"
                        Click="NextQuestion_Click" />
            </Grid>
            <ListBox x:Name="AnswersList" Height="160" />
        </StackPanel>

        <!-- 4 Cyberpunk Answer Buttons (Unstretched with Stretch="Uniform") -->
        <UniformGrid Rows="2" Columns="2" Margin="20,5,20,5">
            <!-- A: Red -->
            <Grid x:Name="OptionABorder" Margin="10">
                <Image Source="avares://Cyber_Defense_Game/Assets/cyberpunk-knop-rood-hd.png"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
                <TextBlock x:Name="OptionAText"
                           Text="A: Red"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                          MaxWidth="310"
           Margin="55,18"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- B: Green -->
            <Grid x:Name="OptionBBorder" Margin="10">
                <Image Source="avares://Cyber_Defense_Game/Assets/cyberpunk-knop-groen-hd.png"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
                <TextBlock x:Name="OptionBText"
                           Text="B: Green"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                      MaxWidth="310"
           Margin="55,18"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- C: Blue -->
            <Grid x:Name="OptionCBorder" Margin="10">
                <Image Source="avares://Cyber_Defense_Game/Assets/cyberpunk-knop-blauw-hd.png"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
                <TextBlock x:Name="OptionCText"
                           Text="C: Blue"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                        MaxWidth="310"
           Margin="55,18"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- D: White -->
            <Grid x:Name="OptionDBorder" Margin="10">
                <Image Source="avares://Cyber_Defense_Game/Assets/cyberpunk-knop-wit-hd.png"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
                <TextBlock x:Name="OptionDText"
                           Text="D: White"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                     MaxWidth="310"
           Margin="55,18"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
        </UniformGrid>
    </DockPanel>
</UserControl>